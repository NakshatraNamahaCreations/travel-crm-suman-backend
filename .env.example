# Server
PORT=5000
NODE_ENV=development

# MongoDB — paste your Atlas URI, or use a local mongod
# Atlas example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/travel_crm
MONGODB_URI=mongodb://127.0.0.1:27017/travel_crm

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=7d

# Platform owner (SaaS super admin) — used by `npm run bootstrap:owner`
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
OWNER_NAME=Platform Owner

# CORS — the client origin
# Comma-separated list of allowed browser origins (CORS). The FIRST entry is
# also used to build customer-facing links (password reset emails), so on a
# deployed server the public app URL must come first.
CLIENT_URL=http://localhost:5173

# PDF rendering — path to a Chrome/Edge executable (auto-detected if blank)
CHROME_PATH=
# Where the PDF renderer caches downscaled images/fonts. Defaults to the OS
# temp dir, which many hosts wipe — point this at persistent storage so the
# first PDF after a restart isn't slow.
PDF_CACHE_DIR=
# Print image sizing. Lower = smaller PDF. Defaults: 760px wide, JPEG q64.
PDF_IMAGE_WIDTH=
PDF_IMAGE_QUALITY=

# Email (SMTP) for "Email to Guest" — leave blank to keep email disabled
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Andaman TravelCare <no-reply@andamantravelcare.com>

# WhatsApp (Gallabox Business API) for "Send via WhatsApp" — leave blank to keep disabled
# https://server.gallabox.com/devapi — get these from your Gallabox account settings
GALLABOX_API_KEY=
GALLABOX_API_SECRET=
GALLABOX_CHANNEL_ID=

# Which transport carries WhatsApp messages: "gallabox" (default) or "openwa".
#   gallabox — Meta's official Business API. Every template needs Gallabox/Meta approval, and
#              a first-contact message MUST be an approved template.
#   openwa   — a self-hosted gateway driving an ordinary WhatsApp account. No approval and no
#              per-message fee, but no delivery guarantee from Meta either, and a number that
#              sends like spam can be restricted. Sends the stored template's own copy as text.
WHATSAPP_PROVIDER=gallabox

# Only read when WHATSAPP_PROVIDER=openwa. The session must already be linked and 'ready'.
# The API key is printed once on OpenWA's first boot and kept in its data/.api-key file.
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# Send the 'enquiry_received' template automatically when a query is created.
# Off unless set to exactly "true" — turning it on messages real guests with no agent review.
# Needs the selected transport configured and the template present and active (Templates page
# → "Restore defaults" adds it); on Gallabox it must also be approved there.
WHATSAPP_AUTO_ENQUIRY=false
